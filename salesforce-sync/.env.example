# Salesforce Credentials
SF_USERNAME=your-salesforce-username@example.com
SF_PASSWORD=your-salesforce-password
SF_SECURITY_TOKEN=your-security-token

# Salesforce Connected App OAuth Credentials
# Create a Connected App in Salesforce Setup to get these
SF_CLIENT_ID=your-connected-app-client-id
SF_CLIENT_SECRET=your-connected-app-client-secret

# Salesforce Login URL
# Use https://login.salesforce.com for production
# Use https://test.salesforce.com for sandbox
SF_LOGIN_URL=https://login.salesforce.com

# Server Configuration
PORT=9000
